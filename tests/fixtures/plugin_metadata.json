{
  "minPluginVersion": "0.1.0",
  "pluginVersion": "0.1.2",
  "qgisPlugin": {
    "schemaVersion": 1,
    "maxFileSizeBytes": 209715200,
    "maxProjectLayers": 20,
    "maxFilenameLength": 255,
    "allowedExtensions": [".zip", ".geojson", ".json"],
    "singlePutThresholdBytes": 104857600,
    "partSizeBytes": 10485760,
    "partConcurrency": 3,
    "retryDelaysSeconds": [1, 3, 5],
    "requestTimeoutSeconds": 15,
    "uploadPartTimeoutSeconds": 300,
    "processingTimeoutSeconds": 600,
    "recentUploadsRefreshSeconds": 5,
    "connectionFeedbackTimeoutSeconds": 5
  }
}
